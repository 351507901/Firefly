---
import type { MarkdownHeading } from "astro";
import FlecDocument from "./FlecDocument.astro";
import FlecShell from "@/components/layout/FlecShell.astro";
interface Props {
 title?: string; description?: string; lang?: string; setOGTypeArticle?: boolean;
 postSlug?: string; postCoverImage?: string; ogImageWidth?: number; ogImageHeight?: number; ogImageAlt?: string;
 postCategory?: string; headings?: MarkdownHeading[]; encrypted?: boolean; heading?: string;
 bannerPostMeta?: { title: string; description?: string; published: Date; updated?: Date; words?: number; minutes?: number; };
}
---
<FlecDocument {...Astro.props}>
 <slot slot="head" name="head" />
 <FlecShell {...Astro.props}><slot /></FlecShell>
</FlecDocument>
