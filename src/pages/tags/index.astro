---
import MainGridLayout from "@/layouts/MainGridLayout.astro";
import { getTagList } from "@/utils/content-utils";
import { getTagUrl } from "@/utils/url-utils";
const tags = await getTagList();
---
<MainGridLayout title="标签">
 <section class="flec-card flec-index-page"><h1>标签</h1><div class="flec-index-tags">
 {tags.map(tag => <a href={getTagUrl(tag.name)} title={tag.name}>{tag.name}</a>)}
 </div></section>
</MainGridLayout>
